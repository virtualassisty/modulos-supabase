{
  "name": "diagnosticos-assistify",
  "version": "1.0.0",
  "description": "Diagnósticos interactivos con Supabase - Assistify",
  "main": "index.html",
  "scripts": {
    "predev": "node scripts/generate-config.js",
    "dev": "npx serve .",
    "dev:vercel": "vercel dev",
    "deploy": "vercel --prod",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "HEADLESS=false playwright test --debug",
    "test:report": "playwright show-report test-results/html-report",
    "test:cleanup": "node tests/cleanup-test-data.js"
  },
  "keywords": [
    "diagnosticos",
    "assistify",
    "supabase"
  ],
  "author": "Assistify",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "google-auth-library": "^9.15.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}

# ════════════════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ════════════════════════════════════════════════════════════════════════════
#
# Configura estas variables en Vercel:
#   vercel env add VARIABLE_NAME
#
# O a través del dashboard: https://vercel.com/[tu-proyecto]/settings/environment-variables
#

# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE
# ──────────────────────────────────────────────────────────────────────────────

# URL de tu proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key (público, usado por formularios)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (PRIVADO, solo en servidor, bypassa RLS)
# ⚠️ CRÍTICO: NUNCA expongas esta key al cliente
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH
# ──────────────────────────────────────────────────────────────────────────────

# Google OAuth Client ID
# Obtenerlo en: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=1019622012963-xxx.apps.googleusercontent.com

# ──────────────────────────────────────────────────────────────────────────────
# JWT SECRET (para firmar sesiones server-side)
# ──────────────────────────────────────────────────────────────────────────────

# Secret para firmar JWT de sesiones (generar con: openssl rand -base64 32)
# ⚠️ CRÍTICO: Debe ser secreto y único por ambiente
JWT_SECRET=tu-secret-super-seguro-aqui-minimo-32-caracteres

# ──────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ──────────────────────────────────────────────────────────────────────────────

# Ambiente (development | production)
NODE_ENV=production
